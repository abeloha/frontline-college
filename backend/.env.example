# Copy this file to .env and fill in real values before deploying.
# Point DB_* at a MySQL server already running on your machine
# (`mysql.server start` / `brew services start mysql`, or your own install).

APP_ENV=development
APP_PORT=8080
FRONTEND_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=frontline
DB_PASSWORD=frontline_pw
DB_NAME=frontline_college

# --- Auth -----------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRY_HOURS=72

# --- Outgoing email (go-mail). Leave SMTP_HOST blank to log emails to the
# console instead of sending them — handy for local development. ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Frontline College of Medical and Health Sciences
SMTP_FROM_EMAIL=admissions@frontlinecollege.edu.ng

# --- Default admin account, seeded on first run ---------------------------
ADMIN_EMAIL=admin@frontlinecollege.edu.ng
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admissions Office

# --- Payment account details shown to applicants in their portal ----------
# TODO: replace with the college's real bank details before going live.
PAYMENT_BANK_NAME=Zenith Bank Plc
PAYMENT_ACCOUNT_NAME=Frontline College of Medical and Health Sciences
PAYMENT_ACCOUNT_NUMBER=1234567890
PAYMENT_CURRENCY=NGN
APPLICATION_FEE_AMOUNT=5000
SCHOOL_FEE_AMOUNT=180000

# --- Payment methods --------------------------------------------------------
# Either or both can be on. Manual is the original bank-transfer + proof-
# upload flow above; Razz issues a disposable virtual account per payment and
# confirms it automatically via webhook (docs/payment-collection-api.md).
MANUAL_PAYMENT_ENABLED=true
RAZZ_PAYMENT_ENABLED=false

# From Razz — get these by having an admin activate a Payment Collection
# config for this school in razz_admin, settling into this school's Razz
# business account. Required only if RAZZ_PAYMENT_ENABLED=true.
RAZZ_API_BASE_URL=
RAZZ_API_KEY=
RAZZ_WEBHOOK_SECRET=

# Webhook URL: https://api.frontlinecollege.com.ng/api/webhooks/razz

# --- File uploads -----------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
